# Node 24.x required. Template only; real credentials belong in backend secret settings.
# See docs/m11e-cloud-readiness.md. Public deployment is deferred to M11-F.
NODE_ENV=production
PORT=5001
MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/placementhub-v2-demo-2027
CLIENT_URL=https://your-frontend.example.com
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
AI_ENABLED=false
# No Ollama process is required.
# Private bucket only. Files are delivered through authenticated backend routes.
STORAGE_PROVIDER=supabase
STORAGE_TIMEOUT_MS=15000
SUPABASE_URL=https://your-project.supabase.co
# Configure a real sb_secret_ key only in the backend hosting secret settings.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=placementhub-2027
