# Future operator template only. Copy to .env.m11e-migration (gitignored).
# Do not run --apply until the separate Atlas data copy and file migration are authorized.
NODE_ENV=production
AI_ENABLED=false
# Dry-run connects only to this local 2027 identity.
MONGO_URI=mongodb://127.0.0.1:27017/placementhub-v2-demo-2027
# --apply reads and conditionally updates ONLY this separately configured Atlas target.
MIGRATION_TARGET_MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/placementhub-v2-demo-2027
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=placementhub-2027
STORAGE_TIMEOUT_MS=15000
# Resolve relative to backend/. These are local source roots, never deleted by this tool.
RESUME_UPLOAD_DIR=uploads/resumes
SOCIAL_UPLOAD_DIR=uploads/community-2027
RESUME_MAX_FILE_SIZE_BYTES=5242880
SOCIAL_IMAGE_MAX_BYTES=5242880
