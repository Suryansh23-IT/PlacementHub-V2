PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/placementhub-v2
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-before-m2
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12
ADMIN_BOOTSTRAP_SECRET=replace-with-a-separate-long-random-bootstrap-secret
DEMO_2027_STUDENT_PASSWORD=
DEMO_2027_COMPANY_PASSWORD=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
RESUME_UPLOAD_DIR=uploads/resumes
RESUME_MAX_FILE_SIZE_BYTES=5242880
PLACEMENT_WITHDRAWAL_RESTRICTION_DRIVES=5
SOCIAL_UPLOAD_DIR=uploads/community-2027
SOCIAL_IMAGE_MAX_BYTES=5242880

# Optional, backend-only. Routes exist only in placementhub-v2-demo-2027.
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
AI_TIMEOUT_MS=180000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RESPONSE_BYTES=65536
AI_MAX_CONTEXT_BYTES=16384
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
AI_MAX_CONCURRENT=1
AI_CACHE_MAX_ENTRIES=100
AI_CACHE_TTL_MS=900000
AI_COOLDOWN_MS=30000
# Company AI: bounded explicit batches and retrieval; Ollama hard cap is 5.
AI_BATCH_LIMIT=4
AI_GROUP_LIMIT=4
AI_RESUME_CACHE_TTL_MS=3600000
AI_RESUME_CACHE_MAX_ENTRIES=100
